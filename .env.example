# Model endpoints and model names are configured in config.yaml.
LLM_API_KEY=
CLASSIFIER_API_KEY=

# Must match the OneBot 11 WebSocket server token in NapCat.
NAPCAT_ACCESS_TOKEN=

# Optional MCP bridge upload endpoint.
MCP_ENABLED=false
MCP_UPLOAD_ENDPOINT=
MCP_UPLOAD_API_TOKEN=

# Optional logging format override.
LOG_JSON=false

# Guild integration (disabled by default in YAML).
GUILD_DATABASE_URL=
GUILD_PUBLIC_URL=
OIDC_ISSUER=
KEYCLOAK_ADMIN_URL=
BOT_KEYCLOAK_CLIENT_ID=
BOT_KEYCLOAK_CLIENT_SECRET=
